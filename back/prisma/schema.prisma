generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../tasks.db"
}

/// Users are only created through the admin API (see src/admin.ts). Everything else belongs to one of them.
model User {
  id           Int          @id @default(autoincrement())
  /// Lowercase; see USERNAME_PATTERN in src/utils/auth.ts.
  username     String       @unique
  /// scrypt hash (see src/utils/auth.ts). Null for accounts nobody can log into: "demo" (the public demo at /demo)
  /// and "#legacy" (data from before logins existed, taken over by the first user created).
  passwordHash String?
  sessions     Session[]
  tasks        Task[]
  recurrences  Recurrence[]
}

/// A logged-in browser.
model Session {
  /// SHA-256 of the token in the session cookie: the database alone can't be used to log in.
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pushed forward while the session is used.
  expiresAt DateTime

  @@index([userId])
}

model Task {
  id         Int     @id @default(autoincrement())
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        Int
  month      Int
  year       Int
  title      String
  /// Minutes since midnight (0..1439). Tasks are ordered by time, then by position.
  time       Int     @default(540)
  position   Int
  /// "Loading": you're already working on it (shows a spinner, skips the notification).
  inProgress Boolean @default(false)
  /// What kind of task it is ("water", "coding"...), only for how it looks. See src/utils/taskTypes.ts.
  type       String  @default("task")

  /// The recurrence that created this task, if any.
  recurrenceId Int?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  @@index([userId, year, month, day])
}

/// A set of tasks created automatically at the start of each matching day.
model Recurrence {
  id       Int              @id @default(autoincrement())
  userId   Int
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  /// Days it applies to, as a bitmask of weekdays: bit 0 = Sunday ... bit 6 = Saturday (127 = every day, 62 = Mon-Fri).
  weekdays Int              @default(127)
  enabled  Boolean          @default(true)
  items    RecurrenceItem[]
  runs     RecurrenceRun[]
  tasks    Task[]

  @@index([userId])
}

model RecurrenceItem {
  id           Int        @id @default(autoincrement())
  recurrenceId Int
  recurrence   Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  /// Empty means "use the recurrence's name".
  title        String
  /// Minutes since midnight (0..1439).
  time         Int
  /// The type of the task it creates.
  type         String     @default("task")
}

/// The days a recurrence already created its tasks for, so completing them never brings them back.
model RecurrenceRun {
  recurrenceId Int
  recurrence   Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  day          Int
  month        Int
  year         Int

  @@id([recurrenceId, day, month, year])
}
