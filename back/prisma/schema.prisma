generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../tasks.db"
}

model Task {
  id       Int    @id @default(autoincrement())
  day      Int
  month    Int
  year     Int
  title    String
  /// Minutes since midnight (0..1439). Tasks are ordered by time, then by position.
  time     Int    @default(540)
  position Int
}
